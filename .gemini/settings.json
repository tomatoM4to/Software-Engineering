{
  "mcpServers": {
    "kis-code-assistant-mcp": {
      "command": "uv",
      "args": [
        "--directory",
        "./kis-code-assistant-mcp",
        "run",
        "server.py",
        "--stdio"
      ]
    },
    "nextjs-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ]
    }
  }
}